# Copy to .env and fill in real values. .env is git-ignored.
# Never ship these to the frontend — the backend holds them.

# --- Ghost ---
GHOST_API_URL=https://your-ghost-site.com
GHOST_ADMIN_API_KEY=<admin_key_id>:<admin_key_secret>
GHOST_CONTENT_API_KEY=<content_api_key>

# --- App config ---
ALERT_EMAIL=you@example.com
BOOK_MILESTONE_MONTHS=12
TRIAL_DAYS=7
CRON_TIME_GMT=06:00          # daily job run time, 24h GMT
DATABASE_PATH=./data/app.sqlite

# --- Email transport (choose one at Phase 3) ---
# Option A: Gmail SMTP (use a Google App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B: Resend / SendGrid
# EMAIL_API_KEY=
